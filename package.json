{
  "name": "mercury-ward",
  "version": "0.1.0",
  "private": true,
  "description": "Mercury Ward v1: scans every page in a site's sitemap for people's names and emails a CSV report.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.6.0"
  }
}
