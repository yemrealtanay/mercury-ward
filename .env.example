PORT=3000

# SQLite dosyası. Boşsa: Railway volume bağlıysa <volume>/mercuryward.db, değilse data/mercuryward.db
DB_PATH=

# E-posta: ilk tanımlı olan kullanılır: SENDGRID_API_KEY > RESEND_API_KEY > SMTP_HOST > konsol.
# Railway Hobby planında SMTP portları kapalı, bu yüzden HTTP API'li SendGrid ya da Resend önerilir.
# SendGrid'de MAIL_FROM adresi doğrulanmış olmalı (Single Sender ya da Domain Authentication).
SENDGRID_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mercury Ward <noreply@example.co.uk>"
MAIL_REPLY_TO=

# Tarama ayarları
MAX_URLS=500
REQUEST_DELAY_MS=1000
# Aynı anda çalışan tarama sayısı
SCAN_CONCURRENCY=3
# true: aynı site aynı anda iki kez taranmaz (test sürecinde kapalı)
ONE_SCAN_PER_SITE=false
MAX_QUEUE=20
# IP ve e-posta başına saatte en fazla tarama; 0 = sınır yok (test için)
RATE_LIMIT_PER_HOUR=5
